{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "nodemon --watch . --ext ts --exec ts-node src/server.ts",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm -- migration:generate migrations/AutoMigration",
        "migration:run": "typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
        "migration:revert": "typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
        "migration:generate:name": "typeorm-ts-node-commonjs -d src/infrastructure/db/dataSource.ts migration:generate"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/config": "^3.3.5",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.2.2",
        "@types/nodemailer": "^7.0.11",
        "eslint": "^10.0.0",
        "express": "^5.2.1",
        "install": "^0.13.0",
        "nodemon": "^3.1.11",
        "npm": "^11.9.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "config": "^4.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "discord.js": "^14.25.1",
        "express-validator": "^7.3.1",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^8.0.2",
        "pg": "^8.18.0",
        "redis": "^5.11.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.28"
    }
}
